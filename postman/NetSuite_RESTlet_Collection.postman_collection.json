{
    "info": {
        "name": "NetSuite RESTlet API Collection",
        "_postman_id": "netsuite-restlet-collection",
        "description": "Complete API collection for interacting with NetSuite RESTlets using Token-Based Authentication (TBA).\n\n## Authentication Setup\n1. Create Integration Record in NetSuite (Setup > Integration > Manage Integrations)\n2. Enable Token-Based Authentication\n3. Create Access Tokens (Setup > Users/Roles > Access Tokens)\n4. Configure OAuth 1.0 in Postman with your credentials\n\n## Environment Variables Required\n- `ns_account_id`: Your NetSuite Account ID (e.g., 123456)\n- `ns_consumer_key`: Integration Consumer Key\n- `ns_consumer_secret`: Integration Consumer Secret\n- `ns_token_id`: Access Token ID\n- `ns_token_secret`: Access Token Secret\n- `ns_restlet_url`: Base RESTlet URL",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "oauth1",
        "oauth1": [
            {
                "key": "consumerKey",
                "value": "{{ns_consumer_key}}",
                "type": "string"
            },
            {
                "key": "consumerSecret",
                "value": "{{ns_consumer_secret}}",
                "type": "string"
            },
            {
                "key": "token",
                "value": "{{ns_token_id}}",
                "type": "string"
            },
            {
                "key": "tokenSecret",
                "value": "{{ns_token_secret}}",
                "type": "string"
            },
            {
                "key": "signatureMethod",
                "value": "HMAC-SHA256",
                "type": "string"
            },
            {
                "key": "realm",
                "value": "{{ns_account_id}}",
                "type": "string"
            },
            {
                "key": "addParamsToHeader",
                "value": true,
                "type": "boolean"
            }
        ]
    },
    "item": [
        {
            "name": "Customer API",
            "description": "Customer management endpoints - Create, Read, Update, Deactivate customers",
            "item": [
                {
                    "name": "Get Customer by ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{ns_restlet_url}}/customer?script=customscript_rl_customer_api&deploy=customdeploy_rl_customer_api&id={{customer_id}}",
                            "host": ["{{ns_restlet_url}}"],
                            "path": ["customer"],
                            "query": [
                                {
                                    "key": "script",
                                    "value": "customscript_rl_customer_api"
                                },
                                {
                                    "key": "deploy",
                                    "value": "customdeploy_rl_customer_api"
                                },
                                {
                                    "key": "id",
                                    "value": "{{customer_id}}",
                                    "description": "NetSuite Internal ID of the customer"
                                }
                            ]
                        },
                        "description": "Retrieve customer details by NetSuite Internal ID"
                    },
                    "response": [
                        {
                            "name": "Success Response",
                            "status": "OK",
                            "code": 200,
                            "body": "{\n    \"success\": true,\n    \"data\": {\n        \"id\": \"12345\",\n        \"entityid\": \"CUST001\",\n        \"companyname\": \"Acme Corporation\",\n        \"email\": \"contact@acme.com\",\n        \"phone\": \"555-123-4567\",\n        \"balance\": 1500.00,\n        \"creditlimit\": 50000.00,\n        \"isinactive\": false\n    }\n}"
                        }
                    ]
                },
                {
                    "name": "Get Customer by Email",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{ns_restlet_url}}/customer?script=customscript_rl_customer_api&deploy=customdeploy_rl_customer_api&email={{customer_email}}",
                            "host": ["{{ns_restlet_url}}"],
                            "path": ["customer"],
                            "query": [
                                {
                                    "key": "script",
                                    "value": "customscript_rl_customer_api"
                                },
                                {
                                    "key": "deploy",
                                    "value": "customdeploy_rl_customer_api"
                                },
                                {
                                    "key": "email",
                                    "value": "{{customer_email}}",
                                    "description": "Customer email address"
                                }
                            ]
                        },
                        "description": "Search for customer by email address"
                    }
                },
