                            "raw": "{\n    \"id\": {{customer_id}},\n    \"phone\": \"555-999-8888\",\n    \"comments\": \"Updated via API\"\n}"
                        },
                        "url": {
                            "raw": "{{ns_restlet_url}}/customer?script=customscript_rl_customer_api&deploy=customdeploy_rl_customer_api",
                            "host": ["{{ns_restlet_url}}"],
                            "path": ["customer"],
                            "query": [
                                {
                                    "key": "script",
                                    "value": "customscript_rl_customer_api"
                                },
                                {
                                    "key": "deploy",
                                    "value": "customdeploy_rl_customer_api"
                                }
                            ]
                        },
                        "description": "Update an existing customer's information"
                    }
                },
                {
                    "name": "Deactivate Customer",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{ns_restlet_url}}/customer?script=customscript_rl_customer_api&deploy=customdeploy_rl_customer_api&id={{customer_id}}",
                            "host": ["{{ns_restlet_url}}"],
                            "path": ["customer"],
                            "query": [
                                {
                                    "key": "script",
                                    "value": "customscript_rl_customer_api"
                                },
                                {
                                    "key": "deploy",
                                    "value": "customdeploy_rl_customer_api"
                                },
                                {
                                    "key": "id",
                                    "value": "{{customer_id}}"
                                }
                            ]
                        },
                        "description": "Soft delete - marks customer as inactive"
                    }
                }
            ]
        },
